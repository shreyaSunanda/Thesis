# Project Specific
# Paths are relative to THIS file (matter-corpus/), not the repo root - the
# previous "matter-corpus/data/..." spelling matched nothing from here, so the
# spec PDFs and pipeline output were never actually ignored.
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/processed/*
!data/processed/.gitkeep

