---- MODULE core_4_21_4_2 ----
EXTENDS Naturals

\* Maximum supported message size (threshold for 0x6A 0x84 error)
CONSTANTS MaxMessageSize

\* Sentinel for no pending input
CONSTANTS NoInput

VARIABLES pendingInput
\* Command parameters from the C-APDU
VARIABLES in_cmd_CLA
VARIABLES in_cmd_P1P2
VARIABLES in_cmd_Lc
VARIABLES in_cmd_Le

\* Responder state
VARIABLES commissioned
VARIABLES rx_expected_len
VARIABLES rx_accumulated_len
VARIABLES tx_pending_len
VARIABLES last_response

Inputs == {
    "Receive_SELECT_Command",
    "Receive_TRANSPORT_Command",
    "Receive_GET_RESPONSE_Command"
}

Operational == commissioned = TRUE

Init ==
    /\ pendingInput = NoInput
    /\ in_cmd_CLA = "None"
    /\ in_cmd_P1P2 = 0
    /\ in_cmd_Lc = 0
    /\ in_cmd_Le = 0
    /\ commissioned = FALSE
    /\ rx_expected_len = 0
    /\ rx_accumulated_len = 0
    /\ tx_pending_len = 0
    /\ last_response = [SW1 |-> "None", SW2 |-> 0]

ReceiveInput(e) ==
    /\ pendingInput = NoInput
    /\ e \in Inputs
    /\ pendingInput' = e
    /\ UNCHANGED <<in_cmd_CLA, in_cmd_P1P2, in_cmd_Lc, in_cmd_Le, commissioned, rx_expected_len, rx_accumulated_len, tx_pending_len, last_response>>

\* SOURCE: core_4.21.4.2 TRANSPORT command
\* "Once commissioning has been successfully initiated with the SELECT command..."
Handle_SELECT_Command ==
    /\ pendingInput = "Receive_SELECT_Command"
    /\ commissioned' = TRUE
    /\ pendingInput' = NoInput
    /\ UNCHANGED <<in_cmd_CLA, in_cmd_P1P2, in_cmd_Lc, in_cmd_Le, rx_expected_len, rx_accumulated_len, tx_pending_len, last_response>>

\* SOURCE: core_4.21.4.2 TRANSPORT command
Handle_TRANSPORT_Command_APDU ==
    /\ pendingInput = "Receive_TRANSPORT_Command"
    /\ commissioned = TRUE
    \* We abstract the length of the response message generated by the application layer.
    /\ \E response_len \in 0..MaxMessageSize:
        \/ /\ in_cmd_P1P2 > MaxMessageSize
           \* Error: chained message exceeds maximum supported size
           /\ last_response' = [SW1 |-> "0x6A", SW2 |-> 132] \* 0x84
           /\ tx_pending_len' = tx_pending_len
           /\ rx_accumulated_len' = rx_accumulated_len
           /\ rx_expected_len' = rx_expected_len
        \/ /\ in_cmd_P1P2 <= MaxMessageSize
           /\ rx_accumulated_len + in_cmd_Lc = in_cmd_P1P2
           \* Complete message received (either unchained or the final fragment of a chain)
           /\ rx_expected_len' = in_cmd_P1P2
           /\ rx_accumulated_len' = rx_accumulated_len + in_cmd_Lc
           /\ IF response_len <= in_cmd_Le THEN
                  \* Response APDU Complete
                  /\ last_response' = [SW1 |-> "0x90", SW2 |-> 0]
                  /\ tx_pending_len' = 0
              ELSE
                  \* Response APDU Incomplete
                  /\ last_response' = [SW1 |-> "0x61", SW2 |-> response_len - in_cmd_Le]
                  /\ tx_pending_len' = response_len - in_cmd_Le
    \* TODO: unspecified - the spec text does not state what SW1/SW2 to return for intermediate C-APDU fragments 
    \* (where rx_accumulated_len + in_cmd_Lc < in_cmd_P1P2). Thus, that case is intentionally left unhandled here.
    /\ pendingInput' = NoInput
    /\ UNCHANGED <<commissioned, in_cmd_CLA, in_cmd_P1P2, in_cmd_Lc, in_cmd_Le>>

Next == 
    \/ (\E e \in Inputs : ReceiveInput(e))
    \/ Handle_SELECT_Command
    \/ Handle_TRANSPORT_Command_APDU

====