InputAlphabet == {"PASE_Establishment_Request", "PASE_PBKDFParamResponse", "PAKE3", "PASE_Establishment_Fail", "CloseSession", "NTL_SELECT", "PASE_Timeout", "ArmFailSafe", "SetRegulatoryConfig", "SetTCAcknowledgements", "CSRRequest", "AddTrustedRootCertificate", "AddNOC", "UpdateFabricLabel", "ScanNetworks", "AddOrUpdateWiFiNetwork", "AddOrUpdateThreadNetwork", "ConnectNetwork", "PowerIndication", "OperationalDiscovery", "CASE_Establishment", "CommissioningComplete"}

