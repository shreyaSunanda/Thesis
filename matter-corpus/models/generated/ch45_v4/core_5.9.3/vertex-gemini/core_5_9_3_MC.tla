InputAlphabet == {"OpNetworkLost", "Wait120sTimeout", "ExtendedAnnouncementTimeout", "InitialStepsHintPerformed", "EstablishCASE", "CASEFailure", "FailsafeTimeout", "ArmFailSafe", "RemoveNetwork", "AddOrUpdateWiFiNetwork", "AddOrUpdateThreadNetwork", "ConnectNetwork", "NewNetworkConnected", "OperationalDiscoveryComplete", "CommissioningComplete", "UserConsentDenied"}

